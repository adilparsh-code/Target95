# Target95 environment template. PLACEHOLDERS ONLY: never put real values here.
# Copy to .env.local (gitignored) for local runs, or enter the values in the
# hosting provider's environment store. See docs/student-bot/STAGING_DEPLOYMENT.md.

# --- Deployment identity -----------------------------------------------------
# "production" (default when unset) or "staging". Anything other than
# "production" makes the site non-indexable and drops canonical URLs.
# "staging" additionally locks Firebase to the project target95-staging.
NEXT_PUBLIC_APP_ENV=staging
# Public origin of THIS deployment (no path). Leave unset on production to keep
# the built-in production origin.
NEXT_PUBLIC_SITE_URL=https://your-staging-preview-url.vercel.app

# --- Firebase web config (browser; from Firebase console > Project settings) -
# All six are required; Firebase is disabled client-side if any is missing.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Firebase Admin (server only; SECRET) -------------------------------------
# Entire service-account JSON on ONE line. Its project_id MUST equal
# NEXT_PUBLIC_FIREBASE_PROJECT_ID or the server refuses to start Firebase Admin.
FIREBASE_SERVICE_ACCOUNT=

# --- Optional -----------------------------------------------------------------
# Admin bootstrap route (/api/auth/admin/bootstrap). Leave unset unless needed.
# TARGET95_ADMIN_BOOTSTRAP_SECRET=
# TARGET95_ADMIN_EMAIL=
# AI and blog features. Leave unset on staging (the Student Bot works without AI).
# OPENAI_API_KEY=

# --- WhatsApp (server only; SECRET; not live yet, see docs/student-bot/WHATSAPP_PLAN.md)
# All four are needed before /api/student-bot/whatsapp does anything.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# Optional Graph API version, e.g. v21.0 (check Meta's current docs).
# WHATSAPP_GRAPH_VERSION=

# --- WhatsApp Channel (public link, NOT a secret). Shows "Follow our Channel" and
# share buttons. Leave unset to hide them. Must look like
# https://whatsapp.com/channel/<id>. Inlined at build time: redeploy after changing.
# NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
