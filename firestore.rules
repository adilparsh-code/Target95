rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    match /users/{userId} {
      // New users may create only their own student profile before verification.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student';

      // Verified users can read their own profile; admins can read user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // A normal user cannot promote themselves, change ownership, change the
      // account email stored in the profile, or forge verification state.
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.emailVerified == resource.data.emailVerified);

      allow delete: if isAdmin();

      match /aiChats/{chatId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
      }
    }

    match /subjects/{subjectId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /chapters/{chapterId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /topics/{topicId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /questions/{questionId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    match /progress/{progressId} {
      allow read: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
      allow delete: if isAdmin();
    }

    match /mockTests/{mockTestId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }
  }
}
