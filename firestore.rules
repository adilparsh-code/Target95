rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    match /users/{userId} {
      // New users may create only their own student profile before verification.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student';

      // Verified users can read their own profile; admins can read user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // A normal user cannot promote themselves, change ownership, or change
      // the account email stored in the profile. Firebase Auth remains the
      // source of truth for email verification.
      // Students may edit only their own profile fields. Status, disabled,
      // role, plan and every other field stay admin/server-only.
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'board', 'studentClass', 'updatedAt']));

      allow delete: if isAdmin();

      match /aiChats/{chatId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
      }

      // Practice data is stored below the authenticated user's document.
      // The path owner, not any client-provided field, determines access.
      match /activeSessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /practiceSessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /practiceAnswers/{answerId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /practiceStatistics/{statisticsId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Server-tracked mock test attempts. Created and graded only by the
      // Admin SDK in /api/mock-tests/attempts; students may read their own.
      match /mockAttempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /subjects/{subjectId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /chapters/{chapterId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /topics/{topicId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /questions/{questionId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isTeacher();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    // Progress documents are self-study completion markers written by
    // useProgress.markCompleted: { chapter, questionId, userId, completedAt }.
    // Students may add and remove their own markers but may not write score,
    // mark or any other field, and may not edit an existing record.
    // Graded marks live only in /results.
    function isCompletionMarker(data) {
      return data.keys().hasOnly(['chapter', 'questionId', 'userId', 'completedAt'])
        && data.keys().hasAll(['chapter', 'questionId', 'userId'])
        && ((data.chapter is string && data.chapter.size() <= 128) || data.chapter is int)
        && ((data.questionId is string && data.questionId.size() <= 128) || data.questionId is int)
        && (!('completedAt' in data) || data.completedAt is string);
    }

    match /progress/{progressId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId)
        && isCompletionMarker(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /mockTests/{mockTestId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isAdmin();
    }

    // Mock test results are written only by trusted server code
    // (/api/mock-tests/attempts/[id]/submit) after server-side grading.
    // No student can create or change a result, their own or anyone else's.
    match /results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }
  }
}
