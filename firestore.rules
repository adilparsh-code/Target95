rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // Account status is trusted only from the server-managed profile at
    // users/{uid}. Students cannot write status/disabled (see the update rule
    // below), so the value cannot be client-controlled. Fails closed: a missing
    // profile, a missing or non-'active' status, or a disabled flag that is
    // anything other than false denies access.
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveProfile(data) {
      return data.get('status', null) == 'active'
        && data.get('disabled', false) == false;
    }

    function hasActiveAccount() {
      return exists(profilePath()) && isActiveProfile(get(profilePath()).data);
    }

    // Verified email AND an active, server-managed account.
    function isActiveUser() {
      return isVerifiedUser() && hasActiveAccount();
    }

    function isOwner(userId) {
      return isActiveUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isActiveUser() && get(profilePath()).data.role == 'admin';
    }

    function isTeacher() {
      return isActiveUser() && get(profilePath()).data.role in ['admin', 'teacher'];
    }

    match /users/{userId} {
      // New users may create only their own student profile before
      // verification. It must start active, never disabled, and may carry
      // only the fields the sign-up flows write.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'fullName', 'avatarUrl', 'role', 'board',
             'studentClass', 'emailVerified', 'createdAt', 'status'
           ]);

      // The sign-in flows check whether a profile exists before creating it,
      // so the signed-in user may read their own path while it is empty.
      allow get: if isAuthenticated()
        && request.auth.uid == userId
        && resource == null;

      // Verified users can read their own profile; admins can read user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // A normal user cannot promote themselves, change ownership, or change
      // the account email stored in the profile. Firebase Auth remains the
      // source of truth for email verification.
      // Students may edit only their own profile fields. Status, disabled,
      // role, plan and every other field stay admin/server-only.
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'board', 'studentClass', 'updatedAt']));

      allow delete: if isAdmin();

      match /aiChats/{chatId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false;
      }

      // Practice data is stored below the authenticated user's document.
      // The path owner, not any client-provided field, determines access.
      match /activeSessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /practiceSessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /practiceAnswers/{answerId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /practiceStatistics/{statisticsId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /subjects/{subjectId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isTeacher();
    }

    match /chapters/{chapterId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isTeacher();
    }

    match /topics/{topicId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isTeacher();
    }

    match /questions/{questionId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isTeacher();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    match /progress/{progressId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /mockTests/{mockTestId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
